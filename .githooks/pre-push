#!/usr/bin/env bash
set -euo pipefail

echo "========================================="
echo "LINT BEFORE PUSH"
echo "========================================="

# YAML
if command -v yamllint >/dev/null 2>&1; then
  yamllint compose/ config/ 2>/dev/null || true
fi

# Shell scripts
if command -v shellcheck >/dev/null 2>&1; then
  find . -name "*.sh" -not -path "./.git/*" -exec shellcheck {} +
fi

# Dockerfiles
if command -v hadolint >/dev/null 2>&1; then
  find . -iname "Dockerfile*" -not -path "./.git/*" -exec hadolint {} +
fi

echo "✅ PUSH ALLOWED"
